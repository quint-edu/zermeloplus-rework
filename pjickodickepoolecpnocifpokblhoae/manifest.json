{
"update_url": "https://clients2.google.com/service/update2/crx",

	"name": "Zermelo++",
	"version": "1.1.0",
	"description": "Een moderne, themable Chrome-extensie voor je actuele Zermelo-rooster",
	"manifest_version": 3,
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"https://*.zportal.nl/*"
	],
	"action": {
		"default_popup": "popup.html"
	},
	"icons": {
		"256": "logo.png"
	}
}